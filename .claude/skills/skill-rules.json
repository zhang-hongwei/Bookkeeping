  "activationRules": {
    "maxActiveSkills": 3,
    "conflictResolution": "priority",
    "activationThreshold": 0.7,
    "deactivationDelay": 300
  },

  "customRules": [
    {
      "name": "Auto-activate testing for test files",
      "condition": {
        "filePattern": "\\.(test|spec)\\.(ts|tsx)$"
      },
      "action": {
        "activateSkills": ["testing"]
      }
    },
    {
      "name": "Activate all dev skills for new features",
      "condition": {
        "promptPattern": "(implement|create).*(new feature|功能)"
      },
      "action": {
        "activateSkills": ["frontend-dev", "backend-dev", "database-dev"]
      }
    }
  ],

  "notes": {
    "enforcement_types": {
      "suggest": "Skill suggestion appears but doesn't block execution (建议但不阻止)",
      "block": "Requires skill to be used before proceeding - guardrail mode (强制要求使用 skill)",
      "warn": "Shows warning but allows proceeding (警告但允许继续)"
    },
    "priority_levels": {
      "critical": "Highest - Always trigger when matched (最高优先级)",
      "high": "Important - Trigger for most matches (重要)",
      "medium": "Moderate - Trigger for clear matches (中等)",
      "low": "Optional - Trigger only for explicit matches (可选)"
    },
    "guardrail_info": {
      "frontend-dev": "Enforces MUI v7 compatibility and custom component usage. Can be skipped by: (1) Using skill in session, (2) Adding @skip-validation comment, (3) Setting SKIP_FRONTEND_GUIDELINES env var",
      "purpose": "Guardrails prevent common mistakes and ensure best practices are followed"
    },
    "customization": {
      "pathPatterns": "Adjust to match your project structure",
      "keywords": "Add domain-specific terms relevant to your project",
      "intentPatterns": "Use regex for flexible user intent matching"
    }
  }
}
