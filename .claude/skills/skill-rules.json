{
  "$schema": "./skill-rules.schema.json",
  "version": "1.0.0",
  "skills": {
    "frontend-dev": {
      "type": "guardrail",
      "enforcement": "block",
      "priority": "high",
      "autoActivate": true,
      "description": "React 19 + Next.js 16 + MUI v7 前端开发最佳实践",
      "promptTriggers": {
        "keywords": [
          "tailwind",
          "frontend",
          "ui",
          "interface",
          "page",
          "layout",
          "modal",
          "dialog",
          "form",
          "button",
          "页面",
          "组件",
          "界面",
          "布局",
          "表单",
          "react component",
          "UI",
          "interface",
          "MUI",
          "Material-UI",
          "Grid",
          "styling",
          "frontend",
          "React"
        ],
        "intentPatterns": [
          "(create|add|build|implement).*?(component|page|ui|interface|modal|form)",
          "(update|modify|change|fix).*?(ui|frontend|component|style)",
          "(style|design|theme).*?(component|page)",
          "创建.*?(页面|组件|界面)",
          "修改.*?(样式|界面|组件)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "src/components/**/*.tsx",
          "src/app/**/page.tsx",
          "src/app/**/layout.tsx",
          "src/features/**/components/**/*.tsx"
        ],
        "extensions": [".tsx", ".jsx"],
        "contentPatterns": [
          "@mui/material",
          "React.FC",
          "useState",
          "useEffect",
          "export.*component",
          "styled-components"
        ]
      },
      "blockMessage": "⚠️ BLOCKED - Frontend Best Practices Required\n\n📋 REQUIRED ACTION:\n1. Use Skill tool: 'frontend-dev'\n2. Review MUI v7 patterns:\n   - Grid uses size={{}} prop, NOT xs/sm props\n   - Use custom components: Modal (not Dialog), Select (not MUI Select), Toast (not Snackbar)\n3. Check React/TypeScript best practices\n4. Use proper styling patterns (sx > styled() > Tailwind)\n5. Then retry this edit\n\nReason: Enforce MUI v7 compatibility and React best practices\nFile: {file_path}\n\n💡 TIP: Add '// @skip-validation' comment to skip future checks",
      "skipConditions": {
        "sessionSkillUsed": true,
        "fileMarkers": ["@skip-validation", "@skip-frontend-validation"],
        "envOverride": "SKIP_FRONTEND_GUIDELINES"
      }
    },

    "backend-dev": {
      "type": "development",
      "priority": "high",
      "autoActivate": true,
      "promptTriggers": {
        "keywords": [
          "api",
          "backend",
          "service",
          "endpoint",
          "route",
          "server",
          "database",
          "query",
          "repository",
          "后端",
          "接口",
          "服务",
          "路由",
          "数据库"
        ],
        "intentPatterns": [
          "(create|add|implement).*?(api|endpoint|service|route)",
          "(handle|process).*?(request|data|business)",
          "创建.*?(接口|服务|API)",
          "处理.*?(请求|数据|业务)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "src/app/api/**/*.ts",
          "src/services/**/*.ts",
          "src/repositories/**/*.ts"
        ],
        "extensions": [".ts"],
        "contentPatterns": [
          "NextRequest",
          "NextResponse",
          "export.*?async.*?function.*(GET|POST|PUT|DELETE)",
          "class.*Service",
          "class.*Repository"
        ]
      }
    },

    "database-dev": {
      "type": "development",
      "priority": "high",
      "autoActivate": true,
      "promptTriggers": {
        "keywords": [
          "database",
          "drizzle",
          "postgres",
          "postgresql",
          "schema",
          "table",
          "migration",
          "query",
          "sql",
          "数据库",
          "表",
          "查询",
          "迁移"
        ],
        "intentPatterns": [
          "(create|add|define).*?(table|schema|model|migration)",
          "(query|select|insert|update|delete).*?(data|record)",
          "创建.*?(表|模型|数据库)",
          "查询.*?(数据|记录)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "src/database/**/*.ts",
          "drizzle.config.ts",
          "**/*.sql"
        ],
        "extensions": [".sql"],
        "contentPatterns": [
          "pgTable",
          "drizzle-orm",
          "CREATE TABLE",
          "ALTER TABLE",
          "db.select",
          "db.insert",
          "db.update",
          "db.delete"
        ]
      }
    },

    "testing": {
      "type": "quality",
      "priority": "medium",
      "autoActivate": true,
      "promptTriggers": {
        "keywords": [
          "test",
          "testing",
          "spec",
          "jest",
          "vitest",
          "unit test",
          "integration test",
          "mock",
          "assert",
          "测试",
          "单元测试",
          "集成测试"
        ],
        "intentPatterns": [
          "(write|create|add).*?test",
          "test.*?(component|function|service|api)",
          "编写.*?测试",
          "测试.*?(组件|函数|服务)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/*.test.ts",
          "**/*.test.tsx",
          "**/*.spec.ts",
          "**/*.spec.tsx",
          "__tests__/**/*"
        ],
        "extensions": [".test.ts", ".test.tsx", ".spec.ts", ".spec.tsx"],
        "contentPatterns": [
          "describe\\(",
          "it\\(",
          "test\\(",
          "expect\\(",
          "vi.mock",
          "render\\("
        ]
      }
    },

    "refactoring": {
      "type": "quality",
      "priority": "medium",
      "autoActivate": true,
      "promptTriggers": {
        "keywords": [
          "refactor",
          "refactoring",
          "optimize",
          "improve",
          "clean",
          "cleanup",
          "restructure",
          "reorganize",
          "重构",
          "优化",
          "改进",
          "整理",
          "清理"
        ],
        "intentPatterns": [
          "(refactor|optimize|improve|clean).*?code",
          "(extract|split|merge|consolidate).*?(function|component|module)",
          "重构.*?代码",
          "优化.*?(性能|结构)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": ["**/*.ts", "**/*.tsx"],
        "contentPatterns": [
          "// TODO.*refactor",
          "// FIXME",
          "// HACK",
          "// @deprecated"
        ]
      }
    },

