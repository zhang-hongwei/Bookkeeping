    "nextjs": {
      "type": "development",
      "priority": "high",
      "autoActivate": true,
      "promptTriggers": {
        "keywords": [
          "nextjs",
          "next.js",
          "server component",
          "client component",
          "app router",
          "use client",
          "page.tsx",
          "layout.tsx",
